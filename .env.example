# Copy to .env (trusted shell assignments; never commit actual endpoints).
DEPLOY_URL=
DEPLOY_SSH=
# Dedicated absolute directory for this app; web server must map /fly/ to
# DEPLOY_ROOT/current/. Confirm this in the infrastructure host's ~/.agents/.
DEPLOY_ROOT=
DEPLOY_BASE=/fly/
# Reserved placement for future backend services; none are needed today.
BACKEND_SSH=
