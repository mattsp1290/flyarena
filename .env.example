# Copy to .env (trusted shell assignments; never commit actual endpoints).
DEPLOY_URL=
DEPLOY_SSH=
# Dedicated absolute directory for this app; web server must map /fly/ to
# DEPLOY_ROOT/current/. Confirm this in the infrastructure host's ~/.agents/.
DEPLOY_ROOT=
DEPLOY_BASE=/fly/
# Reserved placement for future backend services; none are needed today.
BACKEND_SSH=

# Private real-graph lab (scripts/graph-lab.sh; see docs/graph-lab.md and the
# "Real-graph lab" section of .agents/deployment.md). Owner-supplied; never
# commit real values. GRAPH_LAB_TOKEN must be at least 16 characters.
# GRAPH_LAB_ORIGINS must be a comma-separated list including the origin
# (scheme + host, no path) of DEPLOY_URL above. GRAPH_LAB_BIND must exactly
# equal an address printed by `tailscale ip -4` on the Spark -- 0.0.0.0 and
# LAN addresses are rejected. GRAPH_LAB_PORT defaults to 8766 if unset.
GRAPH_LAB_TOKEN=
GRAPH_LAB_ORIGINS=
GRAPH_LAB_BIND=
GRAPH_LAB_PORT=
# Optional: overrides the dedicated bridge subnet (default 172.31.250.0/24).
# GRAPH_LAB_SUBNET=
