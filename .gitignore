# Python (offline graph compiler, scripts/data/)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Raw MaleCNS source exports (see scripts/data/download.py). These are
# large (>1 GB) third-party files pulled from the pinned, hash-verified
# URLs in download.py; only the compiled, small artifact under
# public/data/ is committed.
#
# The trailing-slash form below only matches a real directory named
# data/raw; a worktree convenience symlink (top-level `data`, or
# `data/raw`) is a different entry type and slips past it. The
# no-trailing-slash /data rule below matches the top-level `data` path
# regardless of whether it's a symlink, file, or directory, so it can
# never be staged.
data/raw/
/data

# scripts/training/export-traces.ts output for non-default (--graph/
# --substeps/--include-world) runs: never committed, see the exporter's
# doc comment and its --out overwrite guard.
training/runs/

# scripts/experiments/seed-sweep.ts raw per-seed output: descriptive study
# data, regenerable on demand (npm run experiment:seed-sweep); only the
# small hand-written summary at docs/seed-sweep.md is committed.
scripts/experiments/out/

# Optional DGX sandbox runtime and local evidence
*.egg-info/
backend/build/
lab-results/

# scripts/graph-lab/bundle.mjs output: esbuild bundles of the graph-lab
# entries/workers, copied into the graph-lab image by its Dockerfile.
# Regenerable on demand (npm run graph-lab:bundle); never committed.
backend/graph_lab/js/
