{
  "name": "flyarena",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "training:traces": "tsx scripts/training/export-traces.ts",
    "training:export-arms": "tsx scripts/training/export-arms.ts",
    "training:evaluate": "tsx scripts/training/evaluate.ts",
    "experiment:seed-sweep": "tsx scripts/experiments/seed-sweep.ts",
    "experiment:counterfactual": "tsx scripts/experiments/counterfactual.ts",
    "null:evaluate": "tsx scripts/null/null-evaluate.ts",
    "null:report": "tsx scripts/null/null-report.ts",
    "null:lookup-rewired-artifact": "tsx scripts/null/lookup-rewired-artifact.ts",
    "null:regime-check": "tsx scripts/null/regime-check.ts",
    "intervention:report": "tsx scripts/null/intervention-report.ts",
    "intervention:artifact": "tsx scripts/null/intervention-artifact.ts",
    "analysis:fixture": "tsx scripts/analysis/export-trace-graph-fixture.ts",
    "lesion:evaluate": "tsx scripts/lesion/atlas-evaluate.ts",
    "lesion:report": "tsx scripts/lesion/atlas-report.ts",
    "test:subpath": "playwright test --config playwright.subpath.config.ts",
    "test:deploy-lock": "bash scripts/verify/deploy-lock.test.sh",
    "atlas:publish": "tsx scripts/atlas/cli.ts",
    "atlas:verify": "tsx scripts/atlas/cli.ts --verify public/data/behavior-atlas-v1.json"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "svelte": "^5.57.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "jsdom": "^30.1.1",
    "svelte-check": "^4.7.6",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
